# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/subscriptions

# JWT
SECRET_KEY=change-me-to-32-random-chars
ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Redis
REDIS_URL=redis://cache:6379/0

# Email (Resend)
RESEND_API_KEY=re_your_key_here
RESEND_EMAIL=noreply@yourdomain.com

# App
DEBUG=false